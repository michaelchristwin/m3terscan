{
  "openapi": "3.0.0",
  "info": { "title": "M3terstate Indexer", "version": "1.0.0" },
  "components": {
    "schemas": {
      "M3terstate": {
        "type": "object",
        "properties": {
          "chainLength": {
            "type": "string",
            "example": "1000000000000000000",
            "description": "uint256 as decimal string"
          },
          "txHash": {
            "type": "string",
            "pattern": "^0x[0-9a-fA-F]{64}$",
            "example": "0xabababababababababababababababababababababababababababababababab"
          },
          "meterNo": { "type": "integer", "minimum": 0 },
          "account": {
            "type": "string",
            "example": "1000000000000000000",
            "description": "uint256 as decimal string"
          },
          "nonce": {
            "type": "string",
            "example": "1000000000000000000",
            "description": "uint256 as decimal string"
          }
        },
        "required": ["chainLength", "txHash", "meterNo", "account", "nonce"]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/commits/latest": {
      "get": {
        "responses": {
          "200": {
            "description": "The m3terstates of the commit with the highest chain length",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/M3terstate" }
                }
              }
            }
          },
          "500": { "description": "Invalid response" }
        }
      }
    }
  }
}
